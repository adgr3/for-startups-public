---
import { formatStamp, nextDailyRun } from '../lib/format.js';

export interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  meta?: any;
  activeCount?: number;
  jsonLd?: any;
}
const {
  title,
  description = 'Aktualne i nadchodzące programy, granty, akceleratory i kredyty dla polskich startupów. Każda pozycja z linkiem do oficjalnego źródła.',
  canonicalPath = Astro.url.pathname,
  meta = {},
  activeCount = 0,
  jsonLd = null,
} = Astro.props;

const siteUrl = 'https://for-startups.pages.dev';
const canonical = canonicalPath.startsWith('http') ? canonicalPath : `${siteUrl}${canonicalPath}`;
const generatedAt = typeof meta.generated_at === 'string' ? meta.generated_at : null;
const generatedStamp = formatStamp(generatedAt);
const nextRun = nextDailyRun(new Date());
const nextRunStamp = formatStamp(nextRun.toISOString());
const fullTitle = title.includes('For Startups') ? title : `${title} · For Startups`;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="For Startups" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pl_PL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Przejdź do treści</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href="/">For Startups <span>· radar możliwości</span></a>
        <nav aria-label="Główna nawigacja">
          <a href="/">Katalog</a>
          <a href="/#nadchodzace">Nadchodzące nabory</a>
          <a href="/historia/">Archiwum</a>
        </nav>
      </div>
      <div class="wrap header-meta">
        <span>Aktualne możliwości: <strong>{activeCount}</strong></span>
        <span>
          Ostatnia aktualizacja danych:{' '}
          {generatedStamp
            ? <time datetime={generatedAt}>{generatedStamp}</time>
            : <span class="unknown">brak</span>}
        </span>
        <span>
          Następna planowana aktualizacja:{' '}
          <time datetime={nextRun.toISOString()}>{nextRunStamp}</time>
        </span>
      </div>
    </header>
    <main class="wrap" id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <h2>Jak czytać ten katalog</h2>
          <p>Wartości nieznane są oznaczone jako „nieznane” i nigdy nie są zgadywane ani podstawiane.</p>
          <p>Każdy fakt pochodzi z autorytatywnego źródła wskazanego przy danej możliwości.</p>
          <p>Godziny podajemy tylko wtedy, gdy podaje je źródło — nigdy nie dopisujemy godziny do samej daty.</p>
        </div>
        <div>
          <h2>Harmonogram</h2>
          <p>Codzienne odświeżanie danych: <strong>14:00 Europe/Warsaw</strong>.</p>
          <p>Następny start: <time datetime={nextRun.toISOString()}>{nextRunStamp}</time>.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
<style is:global>
  :root {
    --bg: #0b1020;
    --panel: #141b30;
    --panel-2: #1b2440;
    --ink: #eef2ff;
    --muted: #a7b1d0;
    --accent: #7ab0ff;
    --accent-ink: #07112a;
    --line: #26304d;
    --open: #34d17f;
    --rolling: #4aa8ff;
    --upcoming: #f5bd3c;
    --recurrence: #ff9f43;
    --closed: #98a1ba;
    --paused: #b98cff;
    --unknown: #7d869c;
    --radius: 12px;
    --gap: 16px;
  }
  * { box-sizing: border-box; }
  html { color-scheme: dark; }
  html, body { margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, Ubuntu, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--accent); }
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible,
  summary:focus-visible, [tabindex]:focus-visible {
    outline: 3px solid var(--upcoming);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .skip-link {
    position: absolute; left: -9999px; top: 0; background: var(--upcoming);
    color: #10131f; padding: 10px 16px; z-index: 100; font-weight: 700;
  }
  .skip-link:focus { left: 8px; top: 8px; }
  .wrap { width: 100%; max-width: 1240px; margin: 0 auto; padding: 0 20px; }
  .site-header {
    border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, #121a33, #0b1020);
    position: sticky; top: 0; z-index: 10;
  }
  .header-row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 20px; flex-wrap: wrap; }
  .brand { font-weight: 700; text-decoration: none; color: var(--ink); font-size: 18px; }
  .brand span { color: var(--muted); font-weight: 400; font-size: 14px; }
  nav { display: flex; gap: 6px; flex-wrap: wrap; }
  nav a {
    text-decoration: none; color: var(--muted); padding: 7px 12px;
    border-radius: 8px; border: 1px solid transparent; font-size: 14px;
  }
  nav a:hover { color: var(--ink); background: var(--panel-2); border-color: var(--line); }
  .header-meta {
    display: flex; flex-wrap: wrap; gap: 8px 24px; color: var(--muted);
    font-size: 12.5px; padding: 0 20px 12px;
  }
  .header-meta strong { color: var(--ink); }
  main { padding: 26px 20px 72px; }
  .site-footer { border-top: 1px solid var(--line); color: var(--muted); font-size: 13.5px; padding: 28px 0 40px; }
  .footer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; }
  .footer-grid h2 { font-size: 14px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 0 0 8px; }
  .footer-grid p { margin: 0 0 8px; }
  h1 { font-size: clamp(24px, 3vw, 32px); margin: 6px 0 6px; line-height: 1.2; }
  h2 { line-height: 1.25; }
  .lede { color: var(--muted); margin: 0 0 22px; max-width: 74ch; }
  .unknown { color: var(--muted); font-style: italic; }

  /* ---- controls ---- */
  .controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 12px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 16px;
    margin-bottom: 14px;
    position: sticky; top: 96px; z-index: 5;
    backdrop-filter: blur(6px);
  }
  .controls .search-field { grid-column: span 2; }
  @media (max-width: 560px) { .controls .search-field { grid-column: span 1; } }
  .controls label { display: flex; flex-direction: column; gap: 6px; font-size: 12px; color: var(--muted); font-weight: 600; letter-spacing: .02em; }
  .controls input, .controls select {
    background: var(--panel-2); border: 1px solid var(--line); color: var(--ink);
    border-radius: 8px; padding: 10px 11px; font: inherit; font-size: 14px; min-height: 42px;
  }
  .filter-bar { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; align-items: center; }
  .chip {
    font-size: 13px; padding: 7px 13px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--line); background: var(--panel-2); color: var(--muted);
    font-weight: 600; font-family: inherit;
  }
  .chip:hover { color: var(--ink); border-color: var(--accent); }
  .chip[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
  .chip-label { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; margin-right: 2px; }
  .results-meta { color: var(--muted); font-size: 13px; margin: 0 0 14px; }

  /* ---- responsive catalog grid: 3 / 2 / 1 ---- */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    align-items: stretch;
  }
  @media (max-width: 1024px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 680px) { .grid { grid-template-columns: 1fr; } }

  /* ---- card ---- */
  .card {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 16px;
    display: flex; flex-direction: column; gap: 10px;
    min-width: 0;
  }
  .card:hover { border-color: #33406a; }
  .card h2 { font-size: 16.5px; margin: 0; line-height: 1.3; overflow-wrap: anywhere; }
  .card h2 a { color: var(--ink); text-decoration: none; }
  .card h2 a:hover { text-decoration: underline; }
  .provider { color: var(--muted); font-size: 13px; margin: 0; }
  .badges { display: flex; flex-wrap: wrap; gap: 6px; }
  .badge {
    font-size: 11.5px; padding: 3px 9px; border-radius: 999px;
    border: 1px solid var(--line); background: var(--panel-2); color: var(--ink);
    white-space: nowrap;
  }
  .status-open { background: rgba(52,209,127,.16); border-color: rgba(52,209,127,.5); }
  .status-rolling { background: rgba(74,168,255,.16); border-color: rgba(74,168,255,.5); }
  .status-upcoming { background: rgba(245,189,60,.18); border-color: rgba(245,189,60,.55); }
  .status-recurrence { background: rgba(255,159,67,.18); border-color: rgba(255,159,67,.55); }
  .status-closed { background: rgba(152,161,186,.16); border-color: rgba(152,161,186,.5); }
  .status-paused { background: rgba(185,140,255,.16); border-color: rgba(185,140,255,.5); }
  .status-unknown { background: rgba(125,134,156,.16); border-color: rgba(125,134,156,.5); }
  .badge-hint { font-size: 11.5px; color: var(--muted); margin: -4px 0 0; }
  .countdown {
    font-size: 13px; font-weight: 700; color: var(--upcoming);
    background: rgba(245,189,60,.12); border: 1px dashed rgba(245,189,60,.5);
    border-radius: 8px; padding: 6px 10px;
  }
  .countdown.expected { color: var(--recurrence); background: rgba(255,159,67,.12); border-color: rgba(255,159,67,.5); }
  .summary-pl { font-size: 14px; margin: 0; color: #d9e0f7; }
  dl.facts { display: grid; grid-template-columns: auto minmax(0,1fr); gap: 3px 10px; margin: 0; font-size: 13px; }
  dl.facts dt { color: var(--muted); }
  dl.facts dd { margin: 0; overflow-wrap: anywhere; }
  .benefit-desc { color: var(--muted); font-size: 13.5px; margin: 0; }
  .card-actions { margin-top: auto; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; padding-top: 4px; }
  .btn {
    display: inline-block; background: var(--accent); color: var(--accent-ink);
    text-decoration: none; font-weight: 700; padding: 9px 15px; border-radius: 9px; font-size: 14px;
  }
  .btn:hover { filter: brightness(1.1); }
  .btn-secondary { background: transparent; color: var(--accent); border: 1px solid var(--accent); }
  .freshness { color: var(--muted); font-size: 11.5px; width: 100%; }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin: 34px 0 14px; }
  .section-head h2 { font-size: 20px; margin: 0; }
  .section-head p { margin: 0; color: var(--muted); font-size: 13.5px; }
  .empty, .degraded {
    border: 1px dashed var(--line); border-radius: var(--radius);
    padding: 34px; text-align: center; color: var(--muted); background: var(--panel);
  }
  .degraded { border-color: rgba(245,189,60,.5); }
  .hidden { display: none !important; }
  .card-list { display: grid; gap: var(--gap); }
  .detail-facts { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; }
  .detail-facts dl { display: grid; grid-template-columns: minmax(140px, 220px) 1fr; gap: 8px 16px; margin: 0; }
  .detail-facts dt { color: var(--muted); font-size: 13px; }
  .detail-facts dd { margin: 0; font-size: 14.5px; overflow-wrap: anywhere; }
  @media (max-width: 680px) { .detail-facts dl { grid-template-columns: 1fr; gap: 2px; } .detail-facts dd { margin-bottom: 10px; } }
  .evidence-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .evidence-list li { font-size: 14px; overflow-wrap: anywhere; }
  .back-link { font-size: 14px; }
  .stamp-note { font-size: 12.5px; color: var(--muted); }
</style>
